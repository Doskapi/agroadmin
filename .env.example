# Copiar a .env y completar. En producción la app NO arranca con los valores de ejemplo.
# "desarrollo" permite claves de prueba (solo para tu máquina).
ENTORNO=produccion

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Minutos sin uso hasta que se cierra la sesión
# Minutos sin uso hasta que se cierra la sesión
ACCESS_TOKEN_MINUTES=480

# Usuario administrador que se crea al primer arranque (contraseña de 10 caracteres o más)
ADMIN_EMAIL=admin@miempresa.com.ar
ADMIN_PASSWORD=

# Extracción con IA (opcional). Sin clave, solo se usa el QR de ARCA y el texto del PDF.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

POSTGRES_PASSWORD=agro

# Puerto de la interfaz web
WEB_PUERTO=8080
# Dominio para HTTPS (perfil "https"): docker compose --profile https up -d
DOMINIO=

# Documentación interactiva de la API en /api/docs (apagada por defecto)
DOCS_PUBLICAS=false

# Backups diarios en ./backups
BACKUP_HORA=03
BACKUP_DIAS=30

# Duración máxima de una sesión aunque se siga usando (horas)
SESION_MAXIMA_HORAS=168
# Verificación en dos pasos obligatoria para quienes tengan estos permisos (vacío = opcional para todos)
EXIGIR_2FA=usuarios:admin,facturas:confirmar

# Correo saliente (recuperación de contraseña y avisos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Gestión Agro <no-responder@miempresa.com.ar>
URL_PUBLICA=http://localhost:8080

# Usuario de Postgres de solo lectura `lector` para Metabase (se crea al arrancar si hay contraseña)
LECTOR_DB_PASSWORD=

# Logs: texto o json. Errores a Sentry (opcional)
LOG_FORMATO=texto
SENTRY_DSN=

# Verificación de facturas en ARCA (WSCDC). Certificado con el servicio "wscdc" asociado.
# Montar los archivos en el contenedor (ej. en /data/archivos/arca/) y probar primero en homologación.
ARCA_CUIT=
ARCA_CERTIFICADO=
ARCA_CLAVE_PRIVADA=
ARCA_ENTORNO=homologacion

# Casilla de donde se importan facturas adjuntas (IMAP con SSL)
IMAP_HOST=
IMAP_PUERTO=993
IMAP_USUARIO=
IMAP_PASSWORD=
IMAP_CARPETA=INBOX
# Remitentes o dominios permitidos, separados por coma (vacío = cualquiera)
IMAP_REMITENTES=

# Aviso diario de vencimientos por correo (requiere SMTP)
AVISOS_VENCIMIENTOS=true
